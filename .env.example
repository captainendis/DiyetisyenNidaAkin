# ── Uygulama ──
NODE_ENV=development
PORT=4000
# Sitenin herkese açık kök adresi (canonical, sitemap, OG için). Sonunda / olmadan.
PUBLIC_SITE_URL=http://localhost:5173

# ── Veritabanı ──
DATABASE_URL=postgresql://nida:nida_dev_pw@localhost:5432/nidaakin?schema=public

# ── Güvenlik ──
# 32 baytlık rastgele anahtar (base64). Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Klinik notlar, ölçümler ve danışan dosyaları bu anahtarla şifrelenir. KAYBEDİLİRSE VERİ ÇÖZÜLEMEZ — güvenli yedekleyin.
DATA_ENCRYPTION_KEY=
# Oturum süresi (saat). "Beni hatırla" seçilirse REMEMBER süresi kullanılır.
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
# Uygulama bir ters vekil (nginx, Caddy, Render vb.) arkasındaysa 1 yapın.
TRUST_PROXY=0

# ── Dosya yükleme ──
UPLOAD_DIR=./storage

# ── E-posta (isteğe bağlı) ──
# Boş bırakılırsa e-posta gönderilmez; sistem gönderiyormuş gibi davranmaz.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Demo modu ──
# true ise panelde "Demo verisi" uyarısı gösterilir. Gerçek kullanımda false bırakın.
DEMO_MODE=false

# ── PDF (beslenme planı) ──
# Chromium/Chrome yürütülebilir dosyası. Boşsa Playwright'ın kurulu tarayıcısı kullanılır.
# Docker imajında otomatik ayarlanır (/usr/bin/chromium-browser).
CHROMIUM_PATH=
