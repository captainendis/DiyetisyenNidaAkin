# ── Uygulama ──
NODE_ENV=development
PORT=3000
# Sitenin herkese açık kök adresi (canonical, sitemap, OG için). Sonunda / olmadan.
PUBLIC_SITE_URL=http://localhost:3000

# ── Veritabanı ──
# MySQL 8.0.16+ veya MariaDB 10.6+. Veritabanı utf8mb4 / utf8mb4_unicode_ci olmalı (cPanel varsayılanı).
# Şifrede özel karakter varsa URL kodlayın (ör. @ → %40).
DATABASE_URL=mysql://nida:nida_dev_pw@localhost:3306/nidaakin

# ── Güvenlik ──
# 32 baytlık rastgele anahtar (base64). Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Klinik notlar, ölçümler ve danışan dosyaları bu anahtarla şifrelenir. KAYBEDİLİRSE VERİ ÇÖZÜLEMEZ — güvenli yedekleyin.
DATA_ENCRYPTION_KEY=
# Oturum süresi (saat). "Beni hatırla" seçilirse REMEMBER süresi kullanılır.
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30
# Uygulama bir ters vekil arkasındaysa (cPanel/Passenger, nginx, Caddy …) 1 yapın: gerçek istemci IP'si (hız sınırı, denetim kaydı).
TRUST_PROXY=0

# ── Dosya yükleme ──
# Üretimde uygulama klasörünün DIŞINDA mutlak bir yol verin (ör. /home/kullanici/nidaakin-storage).
UPLOAD_DIR=./storage

# ── E-posta (isteğe bağlı) ──
# Boş bırakılırsa e-posta gönderilmez; sistem gönderiyormuş gibi davranmaz.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Demo modu ──
# true ise panelde "Demo verisi" uyarısı gösterilir. Gerçek kullanımda false bırakın.
DEMO_MODE=false
