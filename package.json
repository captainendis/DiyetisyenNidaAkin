{
  "name": "nida-akin-diyetisyen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc -p tsconfig.app.json && vite build",
    "build:api": "tsc -p tsconfig.server.json && esbuild server/index.ts prisma/seed.ts prisma/seed-demo.ts scripts/create-admin.ts scripts/reset-password.ts scripts/retention.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist-server --entry-names=[name]",
    "start": "node --env-file-if-exists=.env dist-server/index.js",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "admin:reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts",
    "data:retention": "tsx --env-file-if-exists=.env scripts/retention.ts",
    "images": "python3 scripts/prepare-images.py",
    "postinstall": "prisma generate",
    "prod:seed": "node --env-file-if-exists=.env dist-server/seed.js",
    "prod:admin:create": "node --env-file-if-exists=.env dist-server/create-admin.js",
    "prod:admin:reset-password": "node --env-file-if-exists=.env dist-server/reset-password.js",
    "prod:data:retention": "node --env-file-if-exists=.env dist-server/retention.js",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.66.0",
    "luxon": "^3.7.2",
    "motion": "^14.9.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
