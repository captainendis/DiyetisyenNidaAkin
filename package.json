{
  "name": "nida-akin-diyetisyen",
  "private": true,
  "author": "PaperAxis <admin@paperaxis.com> (https://paperaxis.com)",
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/assemble-standalone.mjs && npm run build:scripts",
    "build:scripts": "esbuild prisma/seed.ts prisma/seed-demo.ts scripts/create-admin.ts scripts/reset-password.ts scripts/retention.ts scripts/migrate-pg-to-mysql.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist-scripts --entry-names=[name]",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "admin:reset-password": "tsx --env-file-if-exists=.env scripts/reset-password.ts",
    "data:retention": "tsx --env-file-if-exists=.env scripts/retention.ts",
    "data:migrate-pg": "tsx --env-file-if-exists=.env scripts/migrate-pg-to-mysql.ts",
    "images": "python3 scripts/prepare-images.py",
    "postinstall": "prisma generate",
    "prod:seed": "node --env-file-if-exists=.env dist-scripts/seed.js",
    "prod:admin:create": "node --env-file-if-exists=.env dist-scripts/create-admin.js",
    "prod:admin:reset-password": "node --env-file-if-exists=.env dist-scripts/reset-password.js",
    "prod:data:retention": "node --env-file-if-exists=.env dist-scripts/retention.js",
    "backup": "bash scripts/backup.sh",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/node-server": "^2.1.8",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hono": "^4.13.18",
    "lucide-react": "^1.66.0",
    "luxon": "^3.7.2",
    "mariadb": "^3.5.4",
    "motion": "^14.9.0",
    "next": "^16.4.6",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
