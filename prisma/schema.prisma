// Nida Akın Diyetisyen — veritabanı şeması
// Veritabanı: MySQL 8 / MariaDB 10.6+ (utf8mb4). Tüm zaman damgaları UTC olarak DATETIME(3) saklanır; iş kuralları Europe/Istanbul saat diliminde hesaplanır.
// Takvim günleri (izin günü, ölçüm tarihi, doğum tarihi) saat dilimi kaymasını önlemek için "YYYY-MM-DD" metni olarak tutulur.

generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "esm"
  // Uzantısız içe aktarma: Next.js (Turbopack), tsx ve vitest aynı kaynağı çözebilsin
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

// ───────────────────────────── Kimlik & Yetki ─────────────────────────────

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  /// İzin anahtarları (ör. "clinical:read"). Bkz. server/auth/permissions.ts
  permissions Json
  users       User[]

  @@map("roles")
}

enum RoleKey {
  ADMIN
  DIETITIAN
  ASSISTANT
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  firstName         String
  lastName          String
  /// Panelde hitap için (ör. "Nida Hanım")
  salutation        String?
  passwordHash      String
  roleId            String
  role              Role      @relation(fields: [roleId], references: [id])
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? @db.DateTime(3)
  lastLoginAt       DateTime? @db.DateTime(3)
  passwordChangedAt DateTime? @db.DateTime(3)
  /// { inApp: { [type]: boolean }, email: { [type]: boolean } }
  notificationPrefs Json      @default("{}")
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  sessions           Session[]
  resetTokens        PasswordResetToken[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  consultationNotes  ConsultationNote[]
  blogPosts          BlogPost[]
  statusChanges      AppointmentStatusHistory[]
  measurements       Measurement[]
  clientFiles        ClientFile[]
  nutritionPlans     NutritionPlan[]
  recipes            Recipe[]
  createdAppointments Appointment[]          @relation("AppointmentCreatedBy")
  clientAccountsCreated ClientAccount[]
  clientMessages     ClientMessage[]
  classSessions      ClassSession[]
  classGroupNotes    ClassGroupNote[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  /// Cookie'deki token'ın SHA-256 özeti. Ham token veritabanında tutulmaz.
  tokenHash  String   @unique
  csrfToken  String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  remember   Boolean  @default(false)
  expiresAt  DateTime @db.DateTime(3)
  lastSeenAt DateTime @default(now()) @db.DateTime(3)
  ip         String?
  userAgent  String? @db.Text
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.DateTime(3)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────────────────────── Danışanlar ─────────────────────────────

enum ClientStatus {
  ACTIVE
  PASSIVE
  ARCHIVED
}

enum MeetingType {
  IN_PERSON
  ONLINE
}

enum RecordSource {
  WEBSITE
  PANEL
}

enum ClientSex {
  FEMALE
  MALE
}

model Client {
  id                   String        @id @default(cuid())
  firstName            String
  lastName             String
  phone                String
  email                String?
  /// YYYY-MM-DD, isteğe bağlı
  birthDate            String?       @db.VarChar(10)
  /// Vücut kompozisyonu tahmini (yağ oranı) için; isteğe bağlı
  sex                  ClientSex?
  /// YYYY-MM-DD
  firstVisitDate       String?       @db.VarChar(10)
  preferredMeetingType MeetingType?
  status               ClientStatus  @default(ACTIVE)
  source               RecordSource  @default(PANEL)
  /// Kısa yönetimsel not (sağlık bilgisi içermemeli; klinik notlar consultation_notes'ta şifreli tutulur)
  internalNote         String? @db.Text
  /// KVKK aydınlatma metninin danışana sunulduğu an
  kvkkNoticeAt         DateTime?     @db.DateTime(3)
  /// Sağlık verisi işlenmesine ilişkin açık rıza (ölçüm/beslenme takibi için zorunlu)
  healthConsentAt      DateTime?     @db.DateTime(3)
  healthConsentNote    String? @db.Text
  healthConsentWithdrawnAt DateTime? @db.DateTime(3)
  createdAt            DateTime      @default(now()) @db.DateTime(3)
  updatedAt            DateTime      @updatedAt @db.DateTime(3)

  appointments      Appointment[]
  consultationNotes ConsultationNote[]
  measurements      Measurement[]
  files             ClientFile[]
  notifications     Notification[]
  nutritionPlans    NutritionPlan[]
  recipes           Recipe[]
  account           ClientAccount?
  messages          ClientMessage[]
  classGroups       ClassGroupMember[]
  classAttendances  ClassAttendance[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([email])
  @@map("clients")
}

// ───────────────────────────── Randevular ─────────────────────────────

enum AppointmentStatus {
  /// Web sitesinden saat seçilmeden gelen "beni arayın" talebi
  NEW_REQUEST
  /// Onay bekliyor (web talebi varsayılanı)
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Talebin konusu: beslenme görüşmesi ya da pilates dersi
enum AppointmentKind {
  CONSULTATION
  PILATES
}

enum PilatesFormat {
  /// Küçük grup dersi (en fazla 3 kişi)
  GROUP
  /// Birebir ders
  PRIVATE
}

model Appointment {
  id                   String            @id @default(cuid())
  clientId             String?
  client               Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  serviceId            String?
  service              Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Talep anındaki iletişim bilgisi (danışan kaydı henüz oluşturulmamış olabilir)
  contactName          String
  contactPhone         String
  contactEmail         String?
  /// NEW_REQUEST durumunda boş olabilir
  startsAt             DateTime?         @db.DateTime(3)
  endsAt               DateTime?         @db.DateTime(3)
  meetingType          MeetingType       @default(IN_PERSON)
  kind                 AppointmentKind   @default(CONSULTATION)
  /// Yalnızca pilates taleplerinde
  pilatesFormat        PilatesFormat?
  /// Ziyaretçinin tercih ettiği ISO günler, virgülle ("1,3,5"); boşsa fark etmez
  preferredDays        String?           @db.VarChar(20)
  /// Tercih edilen gün içi aralıklar, virgülle ("MORNING,EVENING"); boşsa fark etmez
  preferredDayparts    String?           @db.VarChar(40)
  status               AppointmentStatus @default(PENDING)
  source               RecordSource      @default(PANEL)
  clientMessage        String? @db.Text
  internalNote         String? @db.Text
  kvkkNoticeAcceptedAt DateTime?         @db.DateTime(3)
  explicitConsentAt    DateTime?         @db.DateTime(3)
  /// Yaklaşan randevu bildiriminin üretildiği an (tekrarı önler)
  reminderNotifiedAt   DateTime?         @db.DateTime(3)
  createdById          String?
  createdBy            User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now()) @db.DateTime(3)
  updatedAt            DateTime          @updatedAt @db.DateTime(3)

  statusHistory     AppointmentStatusHistory[]
  notifications     Notification[]
  consultationNotes ConsultationNote[]
  clientMessages    ClientMessage[]

  @@index([startsAt])
  @@index([status])
  @@index([clientId])
  @@index([kind])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String             @id @default(cuid())
  appointmentId String
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus
  /// Zaman değişikliklerinde önceki/sonraki başlangıç
  previousStartsAt DateTime?       @db.DateTime(3)
  newStartsAt      DateTime?       @db.DateTime(3)
  note          String? @db.Text
  changedById   String?
  changedBy     User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt     DateTime           @default(now()) @db.DateTime(3)

  @@index([appointmentId])
  @@map("appointment_status_history")
}

// ───────────────────────────── Hizmetler ─────────────────────────────

model Service {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  summary         String @db.Text
  description     String @db.Text
  /// Yerleşik çizgi-ikon anahtarı (src/components/icons/ServiceIcon.tsx)
  icon            String   @default("leaf")
  imageUrl        String? @db.VarChar(500)
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  durationMinutes Int?
  /// Kuruş cinsinden; isteğe bağlı
  priceCents      Int?
  showPrice       Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)

  appointments Appointment[]

  @@index([sortOrder])
  @@map("services")
}

// ───────────────────────────── Çalışma takvimi ─────────────────────────────

model AvailabilityRule {
  id            String  @id @default(cuid())
  /// ISO gün numarası: 1 = Pazartesi … 7 = Pazar
  weekday       Int     @unique
  isWorking     Boolean @default(false)
  /// "HH:mm" (Europe/Istanbul)
  startTime     String? @db.VarChar(5)
  endTime       String? @db.VarChar(5)
  breakStart    String? @db.VarChar(5)
  breakEnd      String? @db.VarChar(5)
  slotMinutes   Int     @default(45)
  bufferMinutes Int     @default(15)

  @@map("availability_rules")
}

enum BlockedDateKind {
  /// Tüm gün kapalı
  FULL_DAY
  /// O güne özel çalışma saatleri
  CUSTOM_HOURS
  /// Belirli saat aralığı kapalı
  TIME_RANGE
}

enum BlockedDateReason {
  HOLIDAY
  LEAVE
  MANUAL
  OTHER
}

model BlockedDate {
  id        String            @id @default(cuid())
  /// YYYY-MM-DD (Europe/Istanbul)
  date      String            @db.VarChar(10)
  kind      BlockedDateKind   @default(FULL_DAY)
  reason    BlockedDateReason @default(MANUAL)
  label     String?
  startTime String?           @db.VarChar(5)
  endTime   String?           @db.VarChar(5)
  createdAt DateTime          @default(now()) @db.DateTime(3)

  @@index([date])
  @@map("blocked_dates")
}

// ───────────────────────────── Bildirimler ─────────────────────────────

enum NotificationType {
  APPOINTMENT_REQUESTED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_UPCOMING
  CLIENT_CREATED
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String @db.VarChar(500)
  body          String? @db.Text
  appointmentId String?
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  readAt        DateTime?        @db.DateTime(3)
  createdAt     DateTime         @default(now()) @db.DateTime(3)

  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

enum DeliveryChannel {
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED_NOT_CONFIGURED
  SKIPPED_BY_PREFERENCE
}

/// Harici kanal gönderim kayıtları (e-posta / WhatsApp). Kanal yapılandırılmamışsa SKIPPED_NOT_CONFIGURED yazılır.
model NotificationDelivery {
  id             String          @id @default(cuid())
  notificationId String
  notification   Notification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        DeliveryChannel
  status         DeliveryStatus
  error          String? @db.Text
  createdAt      DateTime        @default(now()) @db.DateTime(3)

  @@map("notification_deliveries")
}

// ───────────────────────────── Klinik kayıtlar (şifreli) ─────────────────────────────

model ConsultationNote {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// AES-256-GCM ile şifrelenmiş içerik (server/lib/crypto.ts)
  contentEnc    String @db.MediumText
  createdAt     DateTime     @default(now()) @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @db.DateTime(3)

  @@index([clientId])
  @@map("consultation_notes")
}

model Measurement {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  measuredOn  String   @db.VarChar(10)
  /// Şifreli JSON: { heightCm, weightKg, targetWeightKg, note }
  dataEnc     String @db.Text
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([clientId, measuredOn])
  @@map("measurements")
}

model ClientFile {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  originalName String @db.VarChar(500)
  /// Disk üzerindeki şifreli dosya adı (UPLOAD_DIR/private)
  storedName   String   @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Danışan hesabında ("Hesabım → Dosyalar") görünsün mü
  visibleToClient Boolean @default(true)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  @@index([clientId])
  @@map("client_files")
}

/// Beslenme planı. Danışana bağlı değilse (clientId boş, isTemplate) yeniden kullanılabilir şablondur.
/// İçerik sağlık verisi niteliği taşıyabileceğinden şifreli tutulur (şema: shared/plan.ts).
model NutritionPlan {
  id          String   @id @default(cuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isTemplate  Boolean  @default(false)
  /// Listeleme için kısa ad (ör. "1. ay, 1. liste"). Kişisel/sağlık bilgisi yazılmamalı.
  name        String
  /// AES-256-GCM şifreli JSON (NutritionPlanData)
  dataEnc     String @db.MediumText
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@index([clientId])
  @@index([isTemplate])
  @@map("nutrition_plans")
}

enum RecipeCategory {
  BREAKFAST
  SNACK
  MAIN
  SOUP
  SALAD
  DESSERT
  DRINK
}

/// Diyetisyenin tarif kütüphanesi; planlara ek sayfa olarak eklenir.
/// Varyasyon: parentId ana tarifi gösterir. clientId doluysa kişiye özel varyasyondur — asla yayınlanmaz,
/// danışan silinince birlikte silinir.
model Recipe {
  id          String         @id @default(cuid())
  /// AES-256-GCM şifreli JSON: { title, summary, ingredients[], steps[], tip } (RecipeContent).
  /// Kişiye özel tarifler sağlık bilgisi içerebildiği için tüm tariflerde içerik şifreli tutulur;
  /// yalnızca açılıştaki taşıma tamamlanana kadar (eski kurulumlarda) kısa süre boş olabilir.
  contentEnc  String? @db.MediumText
  /// Herkese açık adres (/tarifler/<slug>); ilk yayında atanır, sonra değişmez
  slug        String?        @unique
  isPublished Boolean        @default(false)
  publishedAt DateTime?      @db.DateTime(3)
  /// Ana sayfadaki "Mutfaktan" şeridinde gösterilsin mi (doluysa seçilme zamanı; sıralama bu alana göre). En fazla 3.
  featuredAt  DateTime?      @db.DateTime(3)
  parentId    String?
  parent      Recipe?        @relation("RecipeVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants    Recipe[]       @relation("RecipeVariants")
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Varyasyonda neyin değiştiği (ör. "Laktozsuz, glutensiz ekmekle") — AES-256-GCM şifreli; sağlık bilgisi içerebilir
  variantNoteEnc String? @db.Text
  category    RecipeCategory
  servings    Int?
  prepMinutes Int?
  cookMinutes Int?
  /// Porsiyon başına yaklaşık kcal
  kcal        Int?
  /// /uploads/public/recipes/<id> — <base>-480.webp ve <base>-960.webp
  imageBase   String?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  @@index([category])
  @@index([isPublished])
  @@index([parentId])
  @@index([clientId])
  @@map("recipes")
}

// ───────────────────────────── İçerik ─────────────────────────────

model BlogCategory {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  posts     BlogPost[]

  @@map("blog_categories")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String @db.VarChar(255)
  excerpt         String @db.Text
  /// Basit Markdown (başlık, paragraf, liste, kalın/italik, bağlantı)
  content         String @db.MediumText
  coverImageUrl   String? @db.VarChar(500)
  coverImageAlt   String? @db.VarChar(255)
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status          PostStatus    @default(DRAFT)
  seoTitle        String? @db.VarChar(255)
  metaDescription String? @db.Text
  readingMinutes  Int?
  /// Uzman tarafından içerik onayı verildi mi? (yayınlamak için zorunlu)
  expertReviewed  Boolean       @default(false)
  publishedAt     DateTime?     @db.DateTime(3)
  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now()) @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @db.DateTime(3)

  @@index([status, publishedAt])
  @@map("blog_posts")
}

model Faq {
  id          String   @id @default(cuid())
  question    String @db.Text
  answer      String @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@map("faqs")
}

model MediaAsset {
  id          String   @id @default(cuid())
  /// Herkese açık yol (/uploads/public/...)
  url         String   @unique @db.VarChar(500)
  mimeType    String
  sizeBytes   Int
  alt         String? @db.VarChar(500)
  uploadedById String?
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@map("media_assets")
}

/// Anahtar-değer site ayarları (hero, about, contact, social, appointment, kvkk …). Şema: shared/settings.ts
model WebsiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  @@map("website_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String? @db.Text
  createdAt  DateTime @default(now()) @db.DateTime(3)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Danışan hesabı (Hesabım) ─────────────────────────────
// Personel kimliğinden (User/Session) tamamen ayrıdır: ayrı tablo, ayrı cookie ("na_csid"), ayrı API (/api/portal).
// Hesaplar yalnızca "portal:manage" izni olan personel tarafından açılır; danışan şifresini etkinleştirme bağlantısıyla kendisi belirler.

enum ClientTokenPurpose {
  ACTIVATE
  RESET
}

model ClientAccount {
  id                String    @id @default(cuid())
  clientId          String    @unique
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email             String    @unique
  /// Etkinleştirilene kadar boş — bu durumda giriş yapılamaz
  passwordHash      String?
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime? @db.DateTime(3)
  lastLoginAt       DateTime? @db.DateTime(3)
  passwordChangedAt DateTime? @db.DateTime(3)
  activatedAt       DateTime? @db.DateTime(3)
  createdById       String?
  createdBy         User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @db.DateTime(3)

  sessions ClientSession[]
  tokens   ClientAccountToken[]

  @@map("client_accounts")
}

/// Etkinleştirme / şifre sıfırlama bağlantıları. Ham token yalnızca bağlantıda; DB'de SHA-256 özeti.
model ClientAccountToken {
  id        String             @id @default(cuid())
  tokenHash String             @unique
  accountId String
  account   ClientAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  purpose   ClientTokenPurpose
  expiresAt DateTime           @db.DateTime(3)
  usedAt    DateTime?          @db.DateTime(3)
  createdAt DateTime           @default(now()) @db.DateTime(3)

  @@index([accountId])
  @@map("client_account_tokens")
}

model ClientSession {
  id         String        @id @default(cuid())
  tokenHash  String        @unique
  csrfToken  String
  accountId  String
  account    ClientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  remember   Boolean       @default(false)
  expiresAt  DateTime      @db.DateTime(3)
  lastSeenAt DateTime      @default(now()) @db.DateTime(3)
  ip         String?
  userAgent  String? @db.Text
  createdAt  DateTime      @default(now()) @db.DateTime(3)

  @@index([accountId])
  @@index([expiresAt])
  @@map("client_sessions")
}

/// Diyetisyenin danışana yazdığı mesaj/öneri. Klinik notlardan (ConsultationNote) ayrıdır; yalnızca bunlar danışana görünür.
model ClientMessage {
  id            String       @id @default(cuid())
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// AES-256-GCM şifreli metin
  contentEnc    String @db.MediumText
  createdAt     DateTime     @default(now()) @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @db.DateTime(3)

  @@index([clientId])
  @@map("client_messages")
}

// ───────────────────────────── Grup dersleri (Pilates) ─────────────────────────────
// Sabit gruplar (ör. "Salı-Perşembe 18:00", en fazla 3 kişi) ve tarihli dersler. Dersler takvimde zaman kaplar:
// randevularla aynı kilit (withAppointmentLock) altında yazılır ve çakışma kontrolüne girer (server/services/classes.ts).
// Sağlık verisi tutulmaz; yalnızca katılım bilgisi.

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ClassAttendanceStatus {
  /// Derse kayıtlı (henüz sonuçlanmadı)
  BOOKED
  ATTENDED
  NO_SHOW
  /// Haber vererek katılmadı — kontenjandan düşer, yerine telafi danışanı eklenebilir
  EXCUSED
}

model ClassGroup {
  id                     String   @id @default(cuid())
  name                   String   @db.VarChar(80)
  /// Gruptaki en fazla kişi sayısı (pilates için genelde 3)
  capacity               Int      @default(3)
  defaultDurationMinutes Int      @default(50)
  note                   String?  @db.Text
  /// Pasif gruplar listede ayrı gösterilir; geçmiş dersleri korunur
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now()) @db.DateTime(3)
  updatedAt              DateTime @updatedAt @db.DateTime(3)

  members  ClassGroupMember[]
  sessions ClassSession[]
  notes    ClassGroupNote[]

  @@map("class_groups")
}

model ClassGroupMember {
  id        String     @id @default(cuid())
  groupId   String
  group     ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @db.DateTime(3)

  @@unique([groupId, clientId])
  @@index([clientId])
  @@map("class_group_members")
}

model ClassSession {
  id          String             @id @default(cuid())
  /// Grup silinse de geçmiş ders kalır (title anlık kopyadır)
  groupId     String?
  group       ClassGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title       String             @db.VarChar(80)
  startsAt    DateTime           @db.DateTime(3)
  endsAt      DateTime           @db.DateTime(3)
  capacity    Int
  status      ClassSessionStatus @default(SCHEDULED)
  note        String?            @db.Text
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now()) @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @db.DateTime(3)

  attendees ClassAttendance[]

  @@index([startsAt])
  @@index([groupId])
  @@index([status])
  @@map("class_sessions")
}

model ClassAttendance {
  id        String                @id @default(cuid())
  sessionId String
  session   ClassSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    ClassAttendanceStatus @default(BOOKED)
  createdAt DateTime              @default(now()) @db.DateTime(3)
  updatedAt DateTime              @updatedAt @db.DateTime(3)

  @@unique([sessionId, clientId])
  @@index([clientId])
  @@map("class_attendances")
}

// ───────────────────────────── Sistem ─────────────────────────────

/// Uygulama düzeyinde kilitler (ör. "appointments"): satıra SELECT … FOR UPDATE / INSERT … ON DUPLICATE KEY UPDATE
/// ile yazma kilidi alınarak eşzamanlı randevu yazımları serileştirilir. Bkz. server/services/availability.ts
model AppLock {
  name String @id @db.VarChar(64)

  @@map("app_locks")
}

/// Grup not defteri: derste yapılanlar ve sonraki derslerde yapılacaklar
enum ClassGroupNoteKind {
  DONE
  PLANNED
}

model ClassGroupNote {
  id          String             @id @default(cuid())
  groupId     String
  group       ClassGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  kind        ClassGroupNoteKind @default(DONE)
  /// Notun ilgili olduğu gün (YYYY-MM-DD), isteğe bağlı
  noteDate    String?            @db.VarChar(10)
  /// Sakatlık/ağrı gibi sağlık bilgisi içerebilir: AES-256-GCM ile şifreli
  bodyEnc     String             @db.Text
  createdById String?
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now()) @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @db.DateTime(3)

  @@index([groupId, createdAt])
  @@map("class_group_notes")
}
